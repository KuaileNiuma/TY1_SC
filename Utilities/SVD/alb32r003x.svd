    <peripheral><!--LIN1-->
            <name>LIN1</name>
            <headerStructName>LIN1</headerStructName>
            <groupName>LIN</groupName>
            <description>LIN1: Local Interconnect Network controller 1 for single-wire automotive serial communication</description>
            <baseAddress>0x27000000</baseAddress>
            <addressBlock>
                <offset>0x0</offset>
                <size>0x1000</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>LIN1</name>
                <value>158</value>
            <description>interrupt: Handles transfer events</description>
            </interrupt>
            <registers>
                <register><!--SR-->
                    <name>SR</name>
                    <description>USART status register. Monitors the status of the USART communication interface.</description>
                    <addressOffset>0x00</addressOffset>
                    <resetValue>0x00C0</resetValue>
                    <fields>
                        <field><!--CTS-->
                            <name>CTS</name>
                            <description>CTS Flag:This bit is set by hardware when the nCTS input changes state</description>
                            <msb>9</msb>
                            <lsb>9</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>CTS_Enum</name>
                                <enumeratedValue>
                                    <name>Nochange</name>
                                    <description>No change on nCTS status line</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Change</name>
                                    <description>Change on nCTS status line</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--LBD-->
                            <name>LBD</name>
                            <description>	LIN Break Detection Flag</description>
                            <msb>8</msb>
                            <lsb>8</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>LBD_Enum</name>
                                <enumeratedValue>
                                    <name>No LIN break </name>
                                    <description>LIN break not detected</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>LIN break</name>
                                    <description>LIN break detected</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--TXE-->
                            <name>TXE</name>
                            <description>	Transmit Data Register Empty</description>
                            <msb>7</msb>
                            <lsb>7</lsb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <name>TXE_Enum</name>
                                <enumeratedValue>
                                    <name>Nottransferred</name>
                                    <description>Data not transferred to shift register</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Transferred</name>
                                    <description>Data transferred to shift register</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--TC-->
                            <name>TC</name>
                            <description>Transmission Complete</description>
                            <msb>6</msb>
                            <lsb>6</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>TC_Enum</name>
                                <enumeratedValue>
                                    <name>Incomplete</name>
                                    <description>Transmission not complete</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Complete</name>
                                    <description>Transmission complete</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--RXNE-->
                            <name>RXNE</name>
                            <description>	Read Data Register Not Empty</description>
                            <msb>5</msb>
                            <lsb>5</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>RXNE_Enum</name>
                                <enumeratedValue>
                                    <name>Noreceived</name>
                                    <description>No data received</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Received</name>
                                    <description>Received data ready to be read</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--NE-->
                            <name>NE</name>
                            <description>Noise Error Flag</description>
                            <msb>2</msb>
                            <lsb>2</lsb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <name>NE_Enum</name>
