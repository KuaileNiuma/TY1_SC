                </register>
                <register><!--OPTCR0-->
                    <name>OPTCR0</name>
                    <description>OPTCR0: Option-byte control register 0 for user, read-out and write-protection options</description>
                    <addressOffset>0x14</addressOffset>
                    <resetValue>0x0FFFFFED</resetValue>
                    <fields>
                        <field><!--SPRMOD-->
                            <name>SPRMOD</name>
                            <description>Selection of nWPRi bit protection mode</description>
                            <msb>31</msb>
                            <lsb>31</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>SPRMOD_Enum</name>
                                <enumeratedValue>
                                    <name>DISABLED</name>
                                    <description>Prohibit PCROP. The nWPRi bit is used for sector i write protection</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ENABLED</name>
                                    <description>Enable PCROP, and the nWPRi bit is used for sector iPCROP protection.</description>
                                    <value>0x1</value>
                                </enumeratedValue>
