    <peripheral><!--WDT1-->
            <name>WDT1</name>
            <headerStructName>WDT1</headerStructName>
            <groupName>WDT</groupName>
            <description>WDT1: Independent Watchdog Timer 1 for fail-safe system reset on timeout</description>
            <baseAddress>0x29002000</baseAddress>
            <addressBlock>
                <offset>0x0</offset>
                <size>0x1000</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>WDT1</name>
                <value>267</value>
            <description>interrupt: Handles transfer events</description>
            </interrupt>
            <registers>
                <register><!--WDT_CR-->
                    <name>WDT_CR</name>
                    <description>Control Register</description>
                    <addressOffset>0x0</addressOffset>
                    <resetValue>0x0</resetValue>
                    <fields>
                        <field><!--RPL-->
                            <name>RPL</name>
                            <description>Reset pulse length</description>
                            <msb>4</msb>
                            <lsb>2</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>RPL_Enum</name>
                                <enumeratedValue>
                                    <name>PCLK_CYCLES_2</name>
                                    <description>2 cycles</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PCLK_CYCLES_4</name>
                                    <description>4 cycles</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PCLK_CYCLES_8</name>
                                    <description>8 cycles</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PCLK_CYCLES_16</name>
                                    <description>16 cycles</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PCLK_CYCLES_32</name>
                                    <description>32 cycles</description>
                                    <value>0x4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PCLK_CYCLES_64</name>
                                    <description>64 cycles</description>
                                    <value>0x5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PCLK_CYCLES_128</name>
                                    <description>128 cycles</description>
                                    <value>0x6</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PCLK_CYCLES_256</name>
                                    <description>256 cycles</description>
                                    <value>0x7</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--RMOD-->
                            <name>RMOD</name>
                            <description>Writes have no effect when WDT_HC_RMOD=1 (read-only)。</description>
                            <msb>1</msb>
                            <lsb>1</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>RMOD_Enum</name>
                                <enumeratedValue>
                                    <name>RESET</name>
                                    <description>Generate a system reset</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>INTERRUPT</name>
                                    <description>First generate an interupt and even if it is cleared by the time a second timeout occurs then generate a system reset</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register><!--WDT_TORR-->
                    <name>WDT_TORR</name>
                    <description>Timeout Range Register</description>
                    <addressOffset>0x4</addressOffset>
                    <resetValue>0x0</resetValue>
                    <fields>
                        <field><!--TOP_INIT-->
                            <name>TOP_INIT</name>
                            <description>Timeout period for initialization.</description>
                            <msb>7</msb>
                            <lsb>4</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>topInit_Enum</name>
                                <enumeratedValue>
                                    <name>USER0_OR_64K</name>
                                    <description>Time out of WDT_USER_TOP_INIT_0 or 64K Clocks</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>USER1_OR_128K</name>
                                    <description>Time out of WDT_USER_TOP_INIT_1 or 128K Clocks</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>USER2_OR_256K</name>
                                    <description>Time out of WDT_USER_TOP_INIT_2 or 256K Clocks</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>USER3_OR_512K</name>
                                    <description>Time out of WDT_USER_TOP_INIT_3 or 512K Clocks</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>USER4_OR_1M</name>
                                    <description>Time out of WDT_USER_TOP_INIT_4 or 1M KClocks</description>
                                    <value>0x4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>USER5_OR_2M</name>
                                    <description>Time out of WDT_USER_TOP_INIT_5 or 2M Clocks</description>
                                    <value>0x5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>USER6_OR_4M</name>
                                    <description>Time out of WDT_USER_TOP_INIT_6 or 4M Clocks</description>
                                    <value>0x6</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>USER7_OR_8M</name>
                                    <description>Time out of WDT_USER_TOP_INIT_7 or 8M Clocks</description>
                                    <value>0x7</value>
                                </enumeratedValue>
