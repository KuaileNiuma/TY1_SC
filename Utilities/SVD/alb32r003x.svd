	<peripheral><!--EFLASHC-->
		<name>EFLASHC</name>
		<headerStructName>EFLASHC</headerStructName>
		<groupName>EFLASHC</groupName>
		<description>EFLASHC: Embedded Flash Controller managing on-chip program memory</description>
		<baseAddress>0x23000000</baseAddress>
		<addressBlock>
			<offset>0x0</offset>
			<size>0x10</size>
			<usage>registers</usage>
		</addressBlock>
		<interrupt>
			<name>EFLASHC</name>
			<value>99</value>
		<description>interrupt: Handles transfer events</description>
		</interrupt>
		<registers>
			<register><!--ACR-->
				<name>ACR</name>
				<description>ACR: Access-control register for flash wait-state, cache and prefetch configuration</description>
				<addressOffset>0x00</addressOffset>
				<resetValue>0x00000000</resetValue>
				<fields>
					<field><!--PRF_RULE-->
						<name>PRF_RULE</name>
						<description>Instruction prefetching mode</description>
						<msb>16</msb>
						<lsb>16</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>PRF_RULE_Enum</name>
							<enumeratedValue>
								<name>LESS</name>
								<description>It initiates less prefetching mode and is suitable for those with many branch jumps scene.</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>MORE</name>
								<description>More initiate prefetching modes, suitable for sequential scenarios</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--DCRST-->
						<name>DCRST</name>
						<description>Data cache reset enable</description>
						<msb>12</msb>
						<lsb>12</lsb>
						<access>write-only</access>
						<enumeratedValues>
							<name>DCRST_Enum</name>
							<enumeratedValue>
								<name>NO</name>
								<description>The data cache is not bit cleared</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>YES</name>
								<description>Data cache reset and clear</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--ICRST-->
						<name>ICRST</name>
						<description>Data cache reset enable</description>
						<msb>11</msb>
						<lsb>11</lsb>
						<access>write-only</access>
						<enumeratedValues>
							<name>ICRST_Enum</name>
							<enumeratedValue>
								<name>NO</name>
								<description>The data cache is not bit cleared</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>YES</name>
								<description>Data cache reset and clear</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--DCEN-->
						<name>DCEN</name>
						<description>Data cache enable bit</description>
						<msb>10</msb>
						<lsb>10</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>DCEN_Enum</name>
							<enumeratedValue>
								<name>NO</name>
								<description>The data cache is not enabled</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>YES</name>
								<description>Data cache enable</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--ICEN-->
						<name>ICEN</name>
						<description>Data cache enable bit</description>
						<msb>9</msb>
						<lsb>9</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>ICEN_Enum</name>
							<enumeratedValue>
								<name>NO</name>
								<description>The data cache is not enabled</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>YES</name>
								<description>Data cache enable</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--PRFTEN-->
						<name>PRFTEN</name>
						<description>The instruction prefetches the enable bit</description>
						<msb>8</msb>
						<lsb>8</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>PRFTEN_Enum</name>
							<enumeratedValue>
								<name>NO</name>
								<description>Instruction prefetching is not enabled</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>YES</name>
								<description>Instruction prefetch enable</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--LATENCY[2:0]-->
						<name>LATENCY[2:0]</name>
						<description>These bits represent the bus clock cycle and the Flash access time the ratio.</description>
						<msb>2</msb>
						<lsb>0</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>LANTENCY[2:0]_Enum</name>
							<enumeratedValue>
								<name>ZERO</name>
								<description>Zero waiting period </description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>ONE</name>
								<description>One waiting cycle</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
				</fields>
			</register>
			<register><!--KEYR-->
				<name>KEYR</name>
				<description>KEYR: Unlock-key register allowing secure write access to flash control registers</description>
				<addressOffset>0x04</addressOffset>
				<resetValue>0x00000000</resetValue>
				<fields>
					<field><!--FKEYR[31:0]-->
						<name>FKEYR[31:0]</name>
						<description>The key used to unlock the FLASH_CR register must be written in the following order before the FLASH_CR register can be written to initiate erasure and write operations.</description>
						<msb>31</msb>
						<lsb>0</lsb>
						<access>write-only</access>
						<enumeratedValues>
							<name>FKEYR[31:0]_Enum</name>
							<enumeratedValue>
								<name>KEY1</name>
								<description>KEY1</description>
								<value>0x45670123</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>KEY2</name>
								<description>KEY2</description>
								<value>0xCDEF89AB</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
				</fields>
			</register>
			<register><!--OPTKEYR-->
				<name>OPTKEYR</name>
				<description>OPTKEYR: Option-byte key register enabling secure update of system configuration bytes</description>
				<addressOffset>0x08</addressOffset>
				<resetValue>0x00000000</resetValue>
				<fields>
					<field><!--OPTKEYR[31:0]-->
						<name>OPTKEYR[31:0]</name>
						<description>To unlock the FLASH_OPTCR register, the optkey value must be written in the following order before writing to the FLASH_OPTCR register.</description>
						<msb>31</msb>
						<lsb>0</lsb>
						<access>write-only</access>
						<enumeratedValues>
							<name>OPTKEYR[31:0]_Enum</name>
							<enumeratedValue>
								<name>KEY1</name>
								<description>KEY1</description>
								<value>0x08192A3B</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>KEY2</name>
								<description>KEY2</description>
								<value>0x4C5D6E7F</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
				</fields>
			</register>
			<register><!--SR-->
				<name>SR</name>
				<description>SR: Status register indicating flash busy, error and protection flags</description>
				<addressOffset>0x0C</addressOffset>
				<resetValue>0x00000000</resetValue>
				<fields>
					<field><!--BSY-->
						<name>BSY</name>
						<description>Flash is busy</description>
						<msb>16</msb>
						<lsb>16</lsb>
						<access>read-only</access>
						<enumeratedValues>
							<name>BSY_Enum</name>
							<enumeratedValue>
								<name>NO</name>
								<description>No Flash erase or write operations are currently being performed</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>YES</name>
								<description>The Flash erase and write operation is currently being executed</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
				</fields>
			</register>
			<register><!--CR-->
				<name>CR</name>
				<description>CR: Control register for program/erase operations and global flash settings</description>
				<addressOffset>0x10</addressOffset>
				<resetValue>0x80000000</resetValue>
				<fields>
					<field><!--ERRIE-->
						<name>ERRIE</name>
						<description>Incorrect interrupt enable</description>
						<msb>25</msb>
						<lsb>25</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>ERRIE_Enum</name>
							<enumeratedValue>
								<name>DISABLED</name>
								<description>Error interrupts are prohibited</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>ENABLED</name>
								<description>Enable an error interrupt</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--EOPIE-->
						<name>EOPIE</name>
						<description>Interrupt the enable at the end of the operation</description>
						<msb>24</msb>
						<lsb>24</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>EOPIE_Enum</name>
							<enumeratedValue>
								<name>DISABLED</name>
								<description>Interruption is prohibited.</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>ENABLED</name>
								<description>Enabling causes an interruption</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--PSIZE-->
						<name>PSIZE</name>
						<description>Programming size</description>
						<msb>10</msb>
						<lsb>8</lsb>
						<access>read-write</access>
						<enumeratedValues>
