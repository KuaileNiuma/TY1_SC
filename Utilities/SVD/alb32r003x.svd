                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Enabled</name>
                                    <description>USART module enabled</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--M-->
                            <name>M</name>
