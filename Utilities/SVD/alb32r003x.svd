    <peripheral><!--XFLASHC-->
            <name>XFLASHC</name>
            <headerStructName>XFLASHC</headerStructName>
            <groupName>XFLASHC</groupName>
            <description>XFLASH control</description>
            <baseAddress>0x23008000</baseAddress>
            <addressBlock>
                <offset>0x0</offset>
                <size>0x400</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>XFLASHC</name>
                <value>100</value>
            <description>interrupt: Handles transfer events</description>
            </interrupt>
            <registers>
                <register><!--KEYR-->
                    <name>KEYR</name>
                    <description>KEYR: Flash unlock-key register for secure register write access</description>
                    <addressOffset>0x04</addressOffset>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field><!--FKEYR[31:0]-->
                            <name>FKEYR[31:0]</name>
                            <description>The key used to unlock the FLASH_CR register must be written in the following order before the FLASH_CR register can be written to initiate erasure and write operations</description>
                            <msb>31</msb>
                            <lsb>0</lsb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <name>FKEYR[31:0]_Enum</name>
                                <enumeratedValue>
                                    <name>KEY1</name>
                                    <description>KEY1</description>
                                    <value>0x45670123</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>KEY2</name>
                                    <description>KEY2</description>
                                    <value>0xCDEF89AB</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register><!--OPTKEYR-->
                    <name>OPTKEYR</name>
                    <description>OPTKEYR: Option-byte unlock-key register for secure configuration updates</description>
                    <addressOffset>0x08</addressOffset>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field><!--OPTKEYR[31:0]-->
                            <name>OPTKEYR[31:0]</name>
                            <description>To unlock the FLASH_OPTCR register, the optkey value must be written in the following order before writing to the FLASH_OPTCR register.</description>
                            <msb>31</msb>
                            <lsb>0</lsb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <name>OPTKEYR[31:0]_Enum</name>
                                <enumeratedValue>
                                    <name>KEY1</name>
                                    <description>KEY1</description>
                                    <value>0x08192A3B</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>KEY2</name>
                                    <description>KEY2</description>
                                    <value>0x4C5D6E7F</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register><!--SR-->
                    <name>SR</name>
                    <description>SR: Flash status register indicating busy, error and protection states</description>
                    <addressOffset>0x0c</addressOffset>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field><!--BSY-->
                            <name>BSY</name>
                            <description>Flash is busy.</description>
                            <msb>16</msb>
                            <lsb>16</lsb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <name>BSY_Enum</name>
                                <enumeratedValue>
                                    <name>INACTIVE</name>
                                    <description>No Flash erase or write operations are currently being performed</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ACTIVE</name>
                                    <description>The Flash erase and write operation is currently being executed</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register><!--CR-->
                    <name>CR</name>
                    <description>CR: Flash control register for program/erase commands and global settings</description>
                    <addressOffset>0x10</addressOffset>
                    <resetValue>0x80000000</resetValue>
                    <fields>
                        <field><!--ERRIE-->
                            <name>ERRIE</name>
                            <description>Incorrect interrupt enable</description>
                            <msb>25</msb>
                            <lsb>25</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>ERRIE_Enum</name>
                                <enumeratedValue>
                                    <name>DISABLED</name>
                                    <description>Error interrupts are prohibited</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ENABLED</name>
                                    <description>Enable an error interrupt</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--EOPIE-->
                            <name>EOPIE</name>
                            <description>Interrupt the enable at the end of the operation</description>
                            <msb>24</msb>
                            <lsb>24</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>EOPIE_Enum</name>
                                <enumeratedValue>
                                    <name>DISABLED</name>
                                    <description>Interruption is prohibited</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ENABLED</name>
                                    <description>Enabling causes an interruption</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--PSIZE-->
                            <name>PSIZE</name>
                            <description>Programming size</description>
                            <msb>10</msb>
                            <lsb>8</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>PSIZE_Enum</name>
                                <enumeratedValue>
                                    <name>8</name>
                                    <description>x8 Programming</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>16</name>
                                    <description>x16 Programming</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>32</name>
                                    <description>x32 Programming</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>64</name>
                                    <description>x64 Programming</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>128</name>
                                    <description>x128 Programming</description>
                                    <value>0x4</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--SNB-->
                            <name>SNB</name>
                            <description>Sector number</description>
                            <msb>6</msb>
                            <lsb>3</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>SNB_Enum</name>
                                <enumeratedValue>
                                    <name>Sector 0</name>
                                    <description>Sector 0</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 1</name>
                                    <description>Sector 1</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 2</name>
                                    <description>Sector 2</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 3</name>
                                    <description>Sector 3</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 4</name>
                                    <description>Sector 4</description>
                                    <value>0x4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 5</name>
                                    <description>Sector 5</description>
                                    <value>0x5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 6</name>
                                    <description>Sector 6</description>
                                    <value>0x6</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 7</name>
                                    <description>Sector 7</description>
                                    <value>0x7</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 8</name>
                                    <description>Sector 8</description>
                                    <value>0x8</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 9</name>
                                    <description>Sector 9</description>
                                    <value>0x9</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 10</name>
                                    <description>Sector 10</description>
                                    <value>0xa</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Sector 11</name>
                                    <description>Sector 11</description>
                                    <value>0xb</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--MER-->
                            <name>MER</name>
                            <description>Whole-piece erasing enable</description>
                            <msb>2</msb>
                            <lsb>2</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>MER_Enum</name>
                                <enumeratedValue>
                                    <name>ENABLED</name>
                                    <description>Enable the entire FlashMAIN area to be erased</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>DISABLED</name>
                                    <description>Invalid</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field><!--SER-->
                            <name>SER</name>
                            <description>Sector erasure</description>
                            <msb>1</msb>
                            <lsb>1</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>SER_Enum</name>
                                <enumeratedValue>
                                    <name>ENABLED</name>
                                    <description>Enable sector erasure</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
