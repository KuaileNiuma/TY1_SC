    <peripheral><!--WWDG1-->
            <name>WWDG1</name>
            <headerStructName>WWDG1</headerStructName>
            <groupName>WWDG</groupName>
            <description>WWDG1: Windowed Watchdog Timer 1 for time-bounded application monitoring</description>
            <baseAddress>0x29003000</baseAddress>
            <addressBlock>
                <offset>0x0</offset>
                <size>0x1000</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>WWDG1</name>
                <value>1</value>
            <description>interrupt: Handles transfer events</description>
            </interrupt>
            <registers>
                <register><!--CR-->
                    <name>CR</name>
                    <description>CR: Global control register for module enable, mode selection and operational sequencing</description>
                    <addressOffset>0x00</addressOffset>
                    <resetValue>0x7F</resetValue>
                    <fields>
                        <field><!--WDGA-->
                            <name>WDGA</name>
                            <description>Activation bit. This bit is set to '1' by software, but it can only be cleared to '0' by hardware after reset. When WDGA=1, the watchdog can perform a reset</description>
                            <msb>7</msb>
                            <lsb>7</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>WDGA_Enum</name>
                                <enumeratedValue>
                                    <name>DISABLED</name>
                                    <description>Disable the watchdog</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ENABLED</name>
                                    <description>Enable the watchdog</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register><!--CFR-->
                    <name>CFR</name>
                    <description>CFR: Configuration register setting timing, threshold and functional parameters</description>
                    <addressOffset>0x04</addressOffset>
                    <resetValue>0x7F</resetValue>
                    <fields>
                        <field><!--WDGTB[1:0]-->
                            <name>WDGTB[1:0]</name>
                            <description>Timer base</description>
                            <msb>8</msb>
                            <lsb>7</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>WDGTB[1:0]_Enum</name>
                                <enumeratedValue>
                                    <name>0--0</name>
                                    <description>CK timer clock (PCLK1 divided by 4096) divided by 1</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0--1</name>
                                    <description>CK timer clock (PCLK1 divided by 4096) divided by 2</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1--0</name>
                                    <description>CK timer clock (PCLK1 divided by 4096) divided by 4</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1--1</name>
                                    <description>CK timer clock (PCLK1 divided by 4096) divided by 8</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register><!--SR-->
                    <name>SR</name>
                    <description>SR: Status register reflecting current operational state, error flags and event indicators</description>
                    <addressOffset>0x08</addressOffset>
                    <resetValue>0x00</resetValue>
                    <fields>
                    </fields>
                </register>
            </registers>
    </peripheral>
    
