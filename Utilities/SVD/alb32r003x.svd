                                    <name>Wake up by idle bus</name>
                                    <description>Wake up by idle bus</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Wake up by address mark</name>
                                    <description>Wake up by address mark</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
