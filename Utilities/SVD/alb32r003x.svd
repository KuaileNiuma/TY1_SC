							</enumeratedValue>
							<enumeratedValue>
								<name>Sector 11</name>
								<description>Sector 11</description>
								<value>0xb</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>INVALID</name>
								<description>Invalid configuration, retained</description>
								<value>0xc</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>INVALID</name>
								<description>Invalid configuration, retained</description>
								<value>0xd</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>INVALID</name>
