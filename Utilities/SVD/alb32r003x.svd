			<register><!--OPTCR-->
				<name>OPTCR</name>
				<description>OPTCR: Option-byte control register managing user, read-out and write-protection options</description>
				<addressOffset>0x14</addressOffset>
				<resetValue>0x0FFFFFED</resetValue>
				<fields>
					<field><!--SPRMOD-->
						<name>SPRMOD</name>
						<description>Selection of nWPRi bit protection mode</description>
						<msb>31</msb>
						<lsb>31</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>SPRMOD_Enum</name>
							<enumeratedValue>
								<name>DISABLED</name>
								<description>Prohibit PCROP. The nWPRi bit is used for sector i write protection</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>ENABLED</name>
								<description>Enable PCROP. The nWPRi bit is used for sector i PCROP protection.</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--nWRP[11:0]-->
						<name>nWRP[11:0]</name>
						<description>Write protection for sectors 11 to 0</description>
						<msb>27</msb>
						<lsb>16</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>nWRP[11:0]_Enum</name>
							<enumeratedValue>
								<name>ACTIVE</name>
								<description>PCROP protection for unactivated sector i</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>INACTIVE</name>
								<description>Activate the PCROP protection of sector i</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--RDP-->
						<name>RDP</name>
						<description>Read protection</description>
						<msb>15</msb>
						<lsb>8</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>RDP_Enum</name>
							<enumeratedValue>
								<name>Level 0</name>
								<description>Read protection not activated</description>
								<value>0xAA</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>Level 2</name>
								<description>Activate the chip read protection</description>
								<value>0xCC</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>Level 1</name>
								<description>Activate the memory read protection</description>
								<value>0x55</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--nRST_STDBY-->
						<name>nRST_STDBY</name>
						<description>A reset event occurs when entering the stop mode</description>
						<msb>7</msb>
						<lsb>6</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>nRST_STDBY_Enum</name>
							<enumeratedValue>
								<name>YES</name>
								<description>A reset occurs when entering the shutdown mode</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>NO</name>
								<description>No reset occurs</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--WDG_SW-->
						<name>WDG_SW</name>
						<description>Hardware or software watchdog Settings</description>
						<msb>5</msb>
						<lsb>5</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>WDG_SW_Enum</name>
							<enumeratedValue>
								<name>HW</name>
								<description>Hardware independent watchdog</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>SW</name>
								<description>Software-independent watchdog</description>
								<value>0x1</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--BOR_LEV-->
						<name>BOR_LEV</name>
						<description>BOR reset level</description>
						<msb>3</msb>
						<lsb>2</lsb>
						<access>read-write</access>
						<enumeratedValues>
							<name>BOR_LEV_Enum</name>
							<enumeratedValue>
								<name>VBOR3</name>
								<description>Under-voltage threshold level 3</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>VBOR2</name>
								<description>Under-voltage threshold level 2</description>
								<value>0x1</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>VBOR1</name>
								<description>Under-voltage threshold level 1</description>
								<value>0x2</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>CLOSE</name>
								<description>When BOR is turned off, apply the POR/PDR reset threshold voltage</description>
								<value>0x3</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
				</fields>
			</register>
		</registers>
	</peripheral>
        


