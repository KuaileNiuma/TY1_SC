                            <lsb>12</lsb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <name>M_Enum</name>
                                <enumeratedValue>
                                    <name>1 Start bit, 8 data bits, n stop bits</name>
                                    <description>1 Start bit, 8 data bits, n stop bits</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1 Start bit, 9 data bits, n stop bits</name>
                                    <description>1 Start bit, 9 data bits, n stop bits</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
