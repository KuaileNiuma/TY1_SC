                                    <name>Disabled</name>
                                    <description>Parity control disabled</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Enabled</name>
                                    <description>Parity control enabled</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
