								<description>x8 Programming</description>
								<value>0x0</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>16</name>
								<description>x16 Programming</description>
								<value>0x1</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>32</name>
								<description>x32 Programming</description>
								<value>0x2</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>64</name>
								<description>x64 Programming</description>
								<value>0x3</value>
							</enumeratedValue>
							<enumeratedValue>
								<name>128</name>
								<description>x128 Programming</description>
								<value>0x4</value>
							</enumeratedValue>
						</enumeratedValues>
					</field>
					<field><!--SNB-->
						<name>SNB</name>
						<description>Sector number</description>
						<msb>6</msb>
						<lsb>3</lsb>
						<access>read-write</access>
						<enumeratedValues>
