                                    <description>Reserved</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>128</name>
                                    <description>128-bit Key</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
