/* *_MEMROY_SIZE must be numerical only such as 0x10000 or 65536 */

/* ILM Memory Information */
ILM_MEMORY_PRESENT = 1;
ILM_MEMORY_BASE = 0x02000000;
ILM_MEMORY_SIZE = 0x20000;

/* DLM Memory Information */
DLM_MEMORY_PRESENT = 1;
DLM_MEMORY_BASE = 0x03000000;
DLM_MEMORY_SIZE = 0x20000;

/* eFlash Memory Information */
FLASH_MEMORY_PRESENT = 1;
FLASH_MEMORY_BASE = 0x0FF70000;
FLASH_MEMORY_SIZE = 0x80000;

/* xFlash Zero Wait Memory Information */
XFLASHZ_MEMORY_PRESENT = 1;
XFLASHZ_MEMORY_BASE = 0x0FFF0000;
XFLASHZ_MEMORY_SIZE = 0x10000;

/* xFlash Wait Memory Information */
XFLASH_MEMORY_PRESENT = 1;
XFLASH_MEMORY_BASE = 0x10000000;
XFLASH_MEMORY_SIZE = 0x10770000;

/* QSpiFlash Memory Information ， qspi flash*/
QFLASH_MEMORY_PRESENT = 1;
QFLASH_MEMORY_BASE = 0x30000000;
QFLASH_MEMORY_SIZE = 0x800000;

/* SpiFlash Memory Information */
XFLASH_MEMORY_PRESENT = 1;
XFLASH_MEMORY_BASE = 0x10000000;
XFLASH_MEMORY_SIZE = 8*1024*1024-0x10000;

/* SRAM Memory Information */
SRAM_MEMORY_PRESENT = 1;
SRAM_MEMORY_BASE = 0x18000000;
SRAM_MEMORY_SIZE = 0x40000;
/* SRAM_MEMORY_ROM_SIZE must be smaller than SRAM_MEMORY_SIZE */
SRAM_MEMORY_ROM_SIZE = 0x10000;

